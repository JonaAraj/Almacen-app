{
  "name": "almacen-app",
  "version": "1.0.0",
  "description": "Sistema de gestión de inventario de equipos - Almacén App",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backend": "cd Back-end && npm run dev",
    "backend:start": "cd Back-end && npm start",
    "dev": "concurrently \"npm run backend\" \"npm start\"",
    "build:apk": "eas build --platform android",
    "build:apk:local": "eas build --platform android --local",
    "eas:login": "eas login"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-print": "~14.0.1",
    "expo-status-bar": "~3.0.9",
    "react": "19.2.6",
    "react-dom": "^19.2.6",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "react-native-qrcode-scanner": "^1.5.5",
    "react-router-dom": "^7.14.2"
  },
  "private": true,
  "devDependencies": {
    "@types/jspdf": "^1.3.3",
    "concurrently": "^8.2.0"
  }
}
